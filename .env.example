RESEND_API_KEY=
# Where inquiries are delivered
INQUIRY_TO=info@elementumglobal.com
# Sender address. Must be on a domain verified in Resend, e.g. website@elementumglobal.com
INQUIRY_FROM="Elementum Global Website <website@elementumglobal.com>"
